{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true
  },
  // Local packages; office sync links packages/node_modules/@office so their @office imports resolve.
  "include": ["packages"]
}
