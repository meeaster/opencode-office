{
  "name": "office",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Initialize, sync and run an office: a source-controlled folder of desks for OpenCode",
  "scripts": {
    "build": "bun src/build.ts",
    "install-office": "bun src/build.ts --install",
    "test": "bun test --parallel --path-ignore-patterns='**/*.e2e.test.ts'",
    "test:e2e": "bun test --parallel e2e.test",
    "test:all": "bun test --parallel",
    "typecheck": "tsc --noEmit",
    "vendor-artifact-share": "bun src/vendor-artifact-share.ts"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "ajv": "8.20.0",
    "valibot": "1.5.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@pierre/highlights": "0.5.1",
    "@types/bun": "1.4.4",
    "pele": "1.13.0",
    "typescript": "7.0.2"
  }
}
