{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@office/office/context": ["./packages/office/package-context.ts"],
      "@office/references/repositories": ["./packages/references/repositories.ts"],
      "@office/tooling/requirements": ["./packages/tooling/requirements.ts"],
      "@office/mise-integration/claims": ["./packages/mise-integration/claims.ts"]
    },
    "lib": ["esnext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "standard", "packages", "bin/office"],
  // Executor app sources a package ships: `office apps deploy` type-checks them against the `apps`
  // version Executor serves.
  "exclude": ["packages/*/executor-app"]
}
