{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@office/sdk": ["./sdk/index.ts"],
      "@office/sdk/applied-settings": ["./sdk/applied-settings.ts"],
      "@office/references/repositories": ["./packages/references/repositories.ts"],
      "@office/seeds": ["./packages/seeds/handles.ts"],
      "@office/cron": ["./packages/cron/handles.ts"],
      "@office/opencode": ["./packages/opencode/handles.ts"],
      "@office/skills": ["./packages/skills/handles.ts"],
      "@office/executor/apps": ["./packages/executor/apps.ts"],
      "@office/tooling/requirements": ["./packages/tooling/requirements.ts"],
      "@office/tools": ["./packages/tools/handles.ts"],
      "@office/tools/applied": ["./packages/tools/applied.ts"],
      "@office/mise-integration/claims": ["./packages/mise-integration/claims.ts"]
    },
    "lib": ["esnext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "standard", "packages", "sdk", "bin/office"],
  // Executor app sources a package ships: `office apps deploy` type-checks them against the `apps`
  // version Executor serves.
  "exclude": ["packages/*/executor-app"]
}
