{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "packages", "bin/office"],
  // Executor app sources a package ships: `office apps deploy` type-checks them against the `apps`
  // version Executor serves.
  "exclude": ["packages/*/executor-app"]
}
