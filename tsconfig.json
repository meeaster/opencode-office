{
  "compilerOptions": {
    "target": "esnext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "paths": {
      "@office/office/*": ["./packages/office/exports/*"],
      "@office/references/*": ["./packages/references/exports/*"],
      "@office/tooling/*": ["./packages/tooling/exports/*"],
      "@office/mise-integration/*": ["./packages/mise-integration/exports/*"]
    },
    "lib": ["esnext"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "standard", "packages", "bin/office"],
  // Executor app sources a package ships: `office apps deploy` type-checks them against the `apps`
  // version Executor serves.
  "exclude": ["packages/*/executor-app"]
}
